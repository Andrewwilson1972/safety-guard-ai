# ============================================================
# Worker Safety Monitor — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ── Database (required by api-server) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worker_safety

# ── Session secret ────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI backend — pick ONE ─────────────────────────────────────────────────────

# Option A: Ollama (fully offline / self-hosted, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Option B: OpenAI cloud (comment out Option A and set your key)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── Python AI service — stream tuning (all optional) ─────────────────────────
FRAME_SKIP=3          # process every N-th frame (higher = faster, less accurate)
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=25
JPEG_QUALITY=75

# ── AI detection thresholds (optional) ───────────────────────────────────────
YOLO_CONFIDENCE=0.35
DEEPSORT_MAX_AGE=30
ALERT_COOLDOWN=10     # seconds between repeated alerts per worker

# ── Hardware acceleration (optional — auto-detected: cuda > mps > cpu) ───────
# DEVICE=cpu

# ── Custom model paths (optional) ────────────────────────────────────────────
# YOLO_MODEL=ai-service/yolov8n.pt
# MEDIAPIPE_MODEL=ai-service/pose_landmarker_lite.task

# ── Service ports (optional — defaults shown) ─────────────────────────────────
# PORT=3001        # api-server listen port
# API_PORT=3001    # frontend Vite dev proxy target
